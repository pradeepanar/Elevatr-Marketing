      // Helper to classify tier
      function getTier(followersNum) {
        if (followersNum >= 200000) return { key: 'mega', label: 'Mega', badgeClass: 'bg-gold/20 text-gold-light border-gold/40' };
        if (followersNum >= 100000) return { key: 'macro', label: 'Macro', badgeClass: 'bg-white/10 text-white border-white/15' };
        return { key: 'mid', label: 'Mid-Tier', badgeClass: 'bg-slateDark text-silver border-white/10' };
      }

      // Directory State
      const dirState = {
        search: '',
        tier: 'all',
        sort: 'sno',
        showAll: false
      };

      // DOM References
      const dirGrid = document.getElementById('directory-grid');
      const dirEmpty = document.getElementById('directory-empty');
      const dirCountBadge = document.getElementById('directory-count-badge');
      const dirSearchInput = document.getElementById('directory-search');
      const dirSortSelect = document.getElementById('directory-sort');
      const toggleViewAllBtn = document.getElementById('toggle-view-all-btn');
      const resetDirBtn = document.getElementById('reset-directory-btn');
      const tierButtons = document.querySelectorAll('.tier-btn');

      // Render Directory Cards
      function renderDirectory() {
        const query = dirState.search.trim().toLowerCase().replace(/^@/, '');

        let filtered = INFLUENCER_PAGES.filter((page) => {
          const matchesQuery = !query || page.handle.toLowerCase().includes(query) || String(page.sno) === query;
          const tierInfo = getTier(page.followersNum);
          const matchesTier = dirState.tier === 'all' || tierInfo.key === dirState.tier;
          return matchesQuery && matchesTier;
        });

        // Sort
        if (dirState.sort === 'followers-desc') {
          filtered.sort((a, b) => b.followersNum - a.followersNum);
        } else if (dirState.sort === 'alpha') {
          filtered.sort((a, b) => a.handle.toLowerCase().localeCompare(b.handle.toLowerCase()));
        } else {
          filtered.sort((a, b) => a.sno - b.sno);
        }

        // Empty state handling
        if (filtered.length === 0) {
          dirGrid.innerHTML = '';
          dirEmpty.classList.remove('hidden');
          dirCountBadge.textContent = '0 Pages Found';
          toggleViewAllBtn.classList.add('hidden');
          return;
        }

        dirEmpty.classList.add('hidden');

        // Slice to 12 unless showAll is true or user is actively searching
        const limit = (dirState.showAll || query.length > 0) ? filtered.length : 12;
        const visiblePages = filtered.slice(0, limit);

        dirCountBadge.textContent = `Showing ${visiblePages.length} of ${filtered.length} Pages`;

        if (filtered.length <= 12 || query.length > 0) {
          toggleViewAllBtn.classList.add('hidden');
        } else {
          toggleViewAllBtn.classList.remove('hidden');
          toggleViewAllBtn.textContent = dirState.showAll ? 'Show Fewer (12)' : `View All ${filtered.length} Pages`;
        }

        // Build HTML
        dirGrid.innerHTML = visiblePages.map((page) => {
          const tier = getTier(page.followersNum);
          const cleanUrlHandle = encodeURIComponent(page.handle.replace(/\s+/g, ''));
          return `
            <a href="https://instagram.com/${cleanUrlHandle}" target="_blank" rel="noopener noreferrer"
               class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-charcoal p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-gold/60 hover:bg-slateDark/80">
              <div class="flex items-center justify-between gap-2">
                <span class="tabular-nums text-[11px] font-bold text-silver/70">#${String(page.sno).padStart(2, '0')}</span>
                <span class="rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${tier.badgeClass}">
                  ${tier.label}
                </span>
              </div>
              <div class="mt-3 flex items-center justify-between gap-2">
                <p class="truncate text-sm font-bold text-white transition group-hover:text-gold-light" title="@${page.handle}">
                  @${page.handle}
                </p>
                <svg class="h-3.5 w-3.5 shrink-0 text-silver/50 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-gold-light" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                </svg>
              </div>
              <div class="mt-3 flex items-center justify-between border-t border-white/5 pt-2.5">
                <span class="text-[11px] text-silver">Followers</span>
                <span class="tabular-nums rounded-lg bg-obsidian px-2.5 py-1 text-xs font-extrabold text-gold-light">
                  ${page.followersDisplay}
                </span>
              </div>
            </a>
          `;
        }).join('');
      }

      // Directory Event Listeners
      dirSearchInput.addEventListener('input', (e) => {
        dirState.search = e.target.value;
        renderDirectory();
      });

      dirSortSelect.addEventListener('change', (e) => {
        dirState.sort = e.target.value;
        renderDirectory();
      });

      tierButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          dirState.tier = btn.dataset.tier;
          tierButtons.forEach((b) => {
            const active = b === btn;
            b.className = active
              ? 'tier-btn rounded-xl bg-gold px-3.5 py-2 text-xs font-bold text-obsidian transition'
              : 'tier-btn rounded-xl border border-white/10 bg-obsidian px-3.5 py-2 text-xs font-semibold text-silver transition hover:border-gold/50 hover:text-white';
          });
          renderDirectory();
        });
      });

      toggleViewAllBtn.addEventListener('click', () => {
        dirState.showAll = !dirState.showAll;
        renderDirectory();
      });

      resetDirBtn.addEventListener('click', () => {
        dirState.search = '';
        dirState.tier = 'all';
        dirState.sort = 'sno';
        dirSearchInput.value = '';
        dirSortSelect.value = 'sno';
        tierButtons[0].click();
      });

      // Initial directory render
      renderDirectory();

      // -----------------------------------------------------------------
      // 2. INTERACTIVE CAMPAIGN BUDGET CALCULATOR
      // -----------------------------------------------------------------
      const pageSlider = document.getElementById('page-slider');
      const calcPagesDisplay = document.getElementById('calc-pages-display');
      const calcTierPill = document.getElementById('calc-tier-pill');
      const summaryPages = document.getElementById('summary-pages');
      const summaryRate = document.getElementById('summary-rate');
      const summaryTotal = document.getElementById('summary-total');
      const summarySavings = document.getElementById('summary-savings');
      const calcWhatsappBtn = document.getElementById('calc-whatsapp-btn');
      const rateBoxes = [
        document.getElementById('rate-box-1'),
        document.getElementById('rate-box-2'),
        document.getElementById('rate-box-3')
      ];

      function formatINR(num) {
        return '₹' + num.toLocaleString('en-IN');
      }

      function updateCalculator(pageCount) {
        const count = Math.max(1, Math.min(40, parseInt(pageCount, 10) || 1));
        pageSlider.value = count;

        let rate = 1500;
        let tierName = 'Starter Pack Rate Active';
        let activeIdx = 0;

        if (count >= 21) {
          rate = 1250;
          tierName = 'Huge Campaign Rate Active';
          activeIdx = 2;
        } else if (count >= 11) {
          rate = 1350;
          tierName = 'Growth Pack Rate Active';
          activeIdx = 1;
        }

        const total = count * rate;
        const baseTotal = count * 1500;
        const savings = baseTotal - total;

        calcPagesDisplay.textContent = count;
        calcTierPill.textContent = tierName;
        summaryPages.textContent = `${count} ${count === 1 ? 'Page' : 'Pages'}`;
        summaryRate.textContent = formatINR(rate);
        summaryTotal.textContent = formatINR(total);

        if (savings > 0) {
          summarySavings.textContent = `You save ${formatINR(savings)} compared to Starter rate`;
          summarySavings.classList.remove('text-silver');
          summarySavings.classList.add('text-emerald-400');
        } else {
          summarySavings.textContent = 'Select 11+ pages to unlock volume discounts';
          summarySavings.classList.remove('text-emerald-400');
          summarySavings.classList.add('text-silver');
        }

        // Highlight active rate box
        rateBoxes.forEach((box, idx) => {
          if (idx === activeIdx) {
            box.className = 'rounded-xl border border-gold bg-gold/10 p-3 transition';
            box.querySelector('p').className = 'font-semibold text-gold-light';
          } else {
            box.className = 'rounded-xl border border-white/10 bg-charcoal p-3 transition';
            box.querySelector('p').className = 'font-semibold text-silver';
          }
        });

        // Update WhatsApp booking link
        const waText = `Hi Pradeep, I'd like to book a Reels campaign with Elevatr Marketing Agency for ${count} pages at ${formatINR(rate)}/page (Estimated Budget: ${formatINR(total)}).`;
        calcWhatsappBtn.href = `https://wa.me/918610531834?text=${encodeURIComponent(waText)}`;

        // Sync brief form page count gently
        const briefPagesInput = document.getElementById('brief-pages');
        if (briefPagesInput) briefPagesInput.value = count;
      }

      pageSlider.addEventListener('input', (e) => updateCalculator(e.target.value));

      // Pricing Tier Card preset buttons
      document.querySelectorAll('.preset-tier-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          updateCalculator(btn.dataset.presetPages);
          document.getElementById('calculator-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      // Initialize calculator at 20 pages
      updateCalculator(20);

      // -----------------------------------------------------------------
      // 3. TOAST NOTIFICATION & COPY TO CLIPBOARD
      // -----------------------------------------------------------------
      const toastEl = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-message');
      let toastTimer = null;

      function showToast(message) {
        toastMsg.textContent = message;
        toastEl.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        toastEl.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toastEl.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          toastEl.classList.remove('opacity-100', 'translate-y-0');
        }, 3000);
      }

      // Copy WhatsApp Number using document.execCommand('copy') for iFrame compatibility
      const copyPhoneBtn = document.getElementById('copy-phone-btn');
      copyPhoneBtn.addEventListener('click', () => {
        const phoneNumber = '+91 86105 31834';
        try {
          const tempInput = document.createElement('textarea');
          tempInput.value = phoneNumber;
          tempInput.style.position = 'fixed';
          tempInput.style.opacity = '0';
          document.body.appendChild(tempInput);
          tempInput.select();
          document.execCommand('copy');
          document.body.removeChild(tempInput);
          showToast('WhatsApp number +91 86105 31834 copied!');
        } catch (err) {
          showToast('Number: +91 86105 31834');
        }
      });

      // -----------------------------------------------------------------
      // 4. QUICK CAMPAIGN BRIEF FORM -> WHATSAPP
      // -----------------------------------------------------------------
      const briefForm = document.getElementById('campaign-brief-form');
      briefForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('brief-name').value.trim();
        const brand = document.getElementById('brief-brand').value.trim();
        const type = document.getElementById('brief-type').value;
        const pages = document.getElementById('brief-pages').value || 'Not specified';
        const message = document.getElementById('brief-message').value.trim();

        if (!name || !brand) {
          showToast('Please enter your Name and Brand / Project Name.');
          return;
        }

        const formattedText = [
          `Hi Pradeep, New Campaign Enquiry via Elevatr Website:`,
          `• Name: ${name}`,
          `• Brand / Project: ${brand}`,
          `• Campaign Type: ${type}`,
          `• Estimated Pages: ${pages}`,
          message ? `• Notes: ${message}` : ''
        ].filter(Boolean).join('\n');

        const url = `https://wa.me/918610531834?text=${encodeURIComponent(formattedText)}`;
        showToast('Opening WhatsApp with your campaign brief...');
        window.open(url, '_blank', 'noopener,noreferrer');
      });

      // -----------------------------------------------------------------
      // 5. MOBILE NAVIGATION MENU
      // -----------------------------------------------------------------
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      function setMobileMenu(isOpen) {
        mobileMenu.classList.toggle('hidden', !isOpen);
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
        mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
      }

      mobileMenuBtn.addEventListener('click', () => {
        const isCurrentlyClosed = mobileMenu.classList.contains('hidden');
        setMobileMenu(isCurrentlyClosed);
      });

      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => setMobileMenu(false));
      });

      // -----------------------------------------------------------------
      // 6. SCROLL REVEAL ANIMATION
      // -----------------------------------------------------------------
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('visible'));
      }
    })();
  </script>
